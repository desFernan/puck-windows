<Window x:Class="Puck.Input.TextInputBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="360">
  <Border Background="{DynamicResource Surface}"
          BorderBrush="{DynamicResource SurfaceBorder}"
          BorderThickness="1"
          CornerRadius="{DynamicResource CardCorner}"
          Padding="12,10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="#000000" />
    </Border.Effect>
    <StackPanel>
      <TextBlock x:Name="Prompt"
                 Foreground="{DynamicResource TextSecondary}"
                 FontSize="12"
                 Margin="0,0,0,6" />
      <TextBox x:Name="Input"
               Background="Transparent"
               Foreground="{DynamicResource TextPrimary}"
               CaretBrush="{DynamicResource Accent}"
               SelectionBrush="{DynamicResource Accent}"
               BorderThickness="0"
               FontSize="16"
               AcceptsReturn="False"
               TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</Window>
