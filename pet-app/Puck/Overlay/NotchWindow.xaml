<Window x:Class="Puck.Overlay.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Focusable="False">
  <!--
    창은 언제나 열린 크기다(NotchPanelGeometry.WindowFrame). 바뀌는 것은
    여기 그려지는 것뿐이다 — 창이 줄어들면 그 프레임에 커서가 창 밖으로
    나가고, 호버 패널이 깜빡이는 경로가 그것이다.
  -->
  <Grid>
    <!--
      닫힌 모습. 하드웨어처럼 보여야 하므로 검정 단색이고, 아래 두 모서리만
      둥글다. 위쪽은 화면 밖이라 둥글릴 것이 없다.
    -->
    <Border x:Name="ClosedShell"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Background="#FF000000"
            CornerRadius="0,0,10,10" />

    <!-- 열린 모습. -->
    <Border x:Name="OpenShell"
            Background="#FF000000"
            CornerRadius="0,0,18,18"
            Visibility="Collapsed">
      <Grid Margin="18,13,18,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="62" />
          <RowDefinition Height="12" />
          <RowDefinition Height="1" />
          <RowDefinition Height="12" />
          <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- 무엇이 재생 중인가 -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="62" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Background="#FF1C1C1C" CornerRadius="6">
            <TextBlock x:Name="ArtworkGlyph" Text="♪"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#FF6A6A6A" FontSize="26" />
          </Border>

          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="TrackTitle" Foreground="#FFF2F2F2" FontSize="14"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TrackArtist" Foreground="#FF9A9A9A" FontSize="12"
                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
            <Grid Margin="0,7,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ElapsedText" Grid.Column="0" Foreground="#FF7A7A7A"
                         FontSize="10.5" VerticalAlignment="Center" Width="34" />
              <Border x:Name="ProgressTrack" Grid.Column="1" Height="3"
                      Background="#FF2E2E2E" CornerRadius="1.5"
                      VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <Border x:Name="ProgressFill" Background="#FFED8C33" CornerRadius="1.5"
                        HorizontalAlignment="Left" Width="0" />
              </Border>
              <TextBlock x:Name="RemainingText" Grid.Column="2" Foreground="#FF7A7A7A"
                         FontSize="10.5" VerticalAlignment="Center" Width="34"
                         TextAlignment="Right" />
            </Grid>
          </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#FF262626" />

        <!-- 누르는 것들 -->
        <Grid Grid.Row="4">
          <TextBlock x:Name="SourceLabel" HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Foreground="#FF7A7A7A" FontSize="11.5"
                     TextTrimming="CharacterEllipsis" MaxWidth="360" />
          <TextBlock x:Name="StatusLabel" HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Foreground="#FF7A7A7A" FontSize="11.5" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
