<Window x:Class="Puck.ClientWindow.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:client="clr-namespace:Puck.ClientWindow"
        xmlns:island="clr-namespace:Puck.ClientWindow.Island"
        Width="560" Height="640"
        MinWidth="420" MinHeight="360"
        Background="{DynamicResource Background}"
        ShowInTaskbar="True">
  <Window.Resources>
    <!--
      줄 하나의 생김새. 누구 것인지는 색으로만 구분한다 — 말풍선을 그리면
      좁은 창에서 글자 너비가 반으로 준다.
    -->
    <DataTemplate DataType="{x:Type client:TranscriptEntry}">
      <TextBlock Text="{Binding Text}"
                 AutomationProperties.Name="{Binding SpokenText}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,8"
                 FontSize="14">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Kind}" Value="Tool">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12.5" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Kind}" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource StatusError}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Kind}" Value="Notice">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Kind}" Value="User">
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--
      섬. 펫이 찾아올 자리이자 창이 무엇으로 만들어졌는지를 보여 주는 그림이다.
      접으면 그 그림의 색을 딴 띠 하나로 줄어든다.
    -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <island:IslandPanel x:Name="Island" />
      <Button x:Name="FoldButton"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="8"
              Padding="8,2"
              Click="OnFoldClicked" />
    </Grid>

    <ScrollViewer x:Name="Scroller"
                  Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  Margin="0,0,0,12">
      <ItemsControl x:Name="Lines" />
    </ScrollViewer>

    <!-- 승인. 물어볼 것이 없으면 자리를 차지하지 않는다. -->
    <Border x:Name="ApprovalPanel"
            Grid.Row="2"
            AutomationProperties.IsOffscreenBehavior="Onscreen"
            Visibility="Collapsed"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource StatusWarning}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CardCorner}"
            Padding="12,10"
            Margin="0,0,0,12">
      <StackPanel>
        <TextBlock x:Name="ApprovalQuestion"
                   Foreground="{DynamicResource TextPrimary}"
                   FontSize="14"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="ApprovalArguments"
                   Foreground="{DynamicResource TextSecondary}"
                   FontFamily="Consolas"
                   FontSize="12.5"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
          <Button x:Name="DenyButton"
                  MinWidth="72"
                  Padding="10,4"
                  Margin="0,0,8,0"
                  Click="OnDenyClicked" />
          <Button x:Name="AllowButton"
                  MinWidth="72"
                  Padding="10,4"
                  Click="OnAllowClicked" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="3"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource SurfaceBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CardCorner}"
            Padding="12,10">
      <TextBox x:Name="Input"
               Background="Transparent"
               Foreground="{DynamicResource TextPrimary}"
               CaretBrush="{DynamicResource Accent}"
               SelectionBrush="{DynamicResource Accent}"
               BorderThickness="0"
               FontSize="15"
               AcceptsReturn="False"
               TextWrapping="Wrap"
               KeyDown="OnInputKeyDown" />
    </Border>
  </Grid>
</Window>
