<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Puck</AssemblyName>
    <RootNamespace>Puck</RootNamespace>
    <ApplicationIcon>Resources\puck.ico</ApplicationIcon>
    <!--
      WFAC010 tells WinForms apps to move DPI config out of app.manifest and into
      Application.SetHighDpiMode. That is a WinForms-host API; this is a WPF host, so
      the manifest is the only place PerMonitorV2 can be declared before any window exists.
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- [LibraryImport]의 소스 생성기가 unsafe 코드를 내놓는다 (SYSLIB1062). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    WPF is the primary UI framework here; WinForms is on only for NotifyIcon and
    Screen.AllScreens. Its implicit usings would make Application/Point/Color/Size
    ambiguous with System.Windows.*, so drop them - WinForms types get an explicit
    using in the few files that need them.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!--
    효과음. 이 프로젝트가 받는 유일한 NuGet이다.
    BCL의 System.Media.SoundPlayer로는 겹쳐 재생·볼륨·비동기가 안 되는데
    mac의 SFXPlayer는 그 셋을 다 한다(플레이어 노드 풀).
  -->
  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.42.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!--
    진입점 XAML의 파일 이름이 App.xaml이 아니라서 SDK의 기본 글롭이
    ApplicationDefinition으로 잡아 주지 않는다. 직접 지정한다.
  -->
  <ItemGroup>
    <Page Remove="PuckApp.xaml" />
    <ApplicationDefinition Include="PuckApp.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <!--
    동봉 아바타(사용자가 Avatars\에 아무것도 넣지 않아도 펫이 뜬다)와
    트레이 아이콘. TrayIcon이 출력 폴더의 Resources\puck.ico를 찾는다.
  -->
  <ItemGroup>
    <Content Include="Resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
