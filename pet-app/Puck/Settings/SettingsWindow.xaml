<Window x:Class="Puck.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" Height="520"
        MinWidth="380" MinHeight="420"
        Background="{DynamicResource Background}"
        ResizeMode="CanResize"
        ShowInTaskbar="True">
  <Window.Resources>
    <Style TargetType="TextBlock" x:Key="SectionHeader">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Caption">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
    <StackPanel>

      <!-- 아바타 -->
      <TextBlock Text="아바타" Style="{StaticResource SectionHeader}" />
      <ComboBox x:Name="AvatarPicker" />
      <TextBlock x:Name="AvatarCaption" Style="{StaticResource Caption}" />

      <!-- 움직임 -->
      <TextBlock Text="움직임" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
      <DockPanel LastChildFill="True">
        <TextBlock x:Name="SpeedValue" DockPanel.Dock="Right" Width="48"
                   TextAlignment="Right"
                   Foreground="{DynamicResource TextSecondary}" FontSize="12" />
        <Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="3" TickFrequency="0.25"
                IsSnapToTickEnabled="True" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock Text="펫이 걷고 오르는 속도." Style="{StaticResource Caption}" />

      <CheckBox x:Name="AvoidFocused" Content="지금 쓰고 있는 창 위로는 올라가지 않기"
                Margin="0,12,0,0" />
      <TextBlock Text="켜면 맨 앞 창을 벽이 아니라 없는 것처럼 지나칩니다."
                 Style="{StaticResource Caption}" />

      <!-- 노치 -->
      <TextBlock Text="노치" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
      <CheckBox x:Name="NotchEnabled" Content="화면 위에 노치 보이기" />
      <TextBlock x:Name="NotchCaption" Style="{StaticResource Caption}" />

      <!-- 모양 -->
      <TextBlock Text="모양" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
      <ComboBox x:Name="ThemePicker" />
      <TextBlock Text="대화 창과 설정 창의 색." Style="{StaticResource Caption}" />

      <!-- 일반 -->
      <TextBlock Text="일반" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
      <CheckBox x:Name="LaunchAtLoginBox" Content="로그인할 때 자동으로 시작" />
      <TextBlock x:Name="LaunchCaption" Style="{StaticResource Caption}" />

    </StackPanel>
  </ScrollViewer>
</Window>
